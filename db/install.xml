<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="/local/pluginusagereporter/db" VERSION="2025041300">
  <TABLES>
  
    <!-- Main reports table -->
    <TABLE NAME="local_pluginusagereporter_reports">
      <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
      <!-- Below we can add User ID etc. just for testing -->
      <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="true"/>
      <FIELD NAME="timeframe_days" TYPE="int" LENGTH="4" NOTNULL="true"/>
      <FIELD NAME="report_data" TYPE="text" NOTNULL="true"/>
      <FIELD NAME="report_format" TYPE="char" LENGTH="10" NOTNULL="true"/>
      <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    </TABLE>

    <!-- [Since v1.1.1-10 B]: Logging table for Plugin Usage Reporter -->
    <TABLE NAME="local_pluginusagereporter_log" COMMENT="Log table for Plugin Usage Reporter events">
      <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
      <FIELD NAME="eventtime" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Timestamp of the event"/>
      <FIELD NAME="eventtype" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="Type of event (success, error)"/>
      <FIELD NAME="message" TYPE="text" NOTNULL="true" COMMENT="Event message"/>
      <FIELD NAME="additionaldata" TYPE="text" NOTNULL="false" COMMENT="Optional additional data as JSON"/>
      <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    </TABLE>

  </TABLES>
</XMLDB>
